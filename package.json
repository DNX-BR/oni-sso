{
  "name": "oni-sso",
  "version": "3.0.0",
  "description": "tool for login by sso (Google, Azure and AWS SSO)",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "oni-sso": "dist/src/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "author": "favachinho",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-sso": "^3.1075.0",
    "@aws-sdk/client-sso-oidc": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1075.0",
    "@inquirer/prompts": "^8.7.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.9.3",
    "ini": "^5.0.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0"
  }
}
